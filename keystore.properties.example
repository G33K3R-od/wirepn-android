# Copy this file to keystore.properties in the repo root and fill in values.
# Never commit keystore.properties or your keystore file.
#
# Generate a keystore (example):
#   keytool -genkeypair -v -keystore wirepn-release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias wirepn
#
# Paths can be relative to the repository root.

storeFile=path/to/your-release.jks
storePassword=
keyAlias=
keyPassword=
